			"get": "/get",
			"post": "/post",
			"put": "/put",
			"delete": "/delete"
		},
		"public-files": "/files/public",
		"private-files": "/files/private",
		"templates": "/templates"
	},
	"content-types": {
		"htm": "text/html",
		"html": "text/html",
		"css": "text/css",
		"js": "text/javascript",
		"jpg": "image/jpeg",
		"jpeg": "image/jpeg",
